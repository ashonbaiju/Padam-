RewriteEngine On

# Serve existing files and directories normally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route all /api/* requests to php-api/index.php
RewriteRule ^api/(.*)$ php-api/index.php [L,QSA]

# React SPA fallback — route all non-file, non-api requests to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(?!api/)(.*)$ index.html [L]

# Security: block access to PHP source and storage
<FilesMatch "\.(php)$">
    # Allow only the API entry point
    Require all denied
</FilesMatch>

<Files "php-api/index.php">
    Require all granted
</Files>

# Block storage directory from web access
<Directory "storage">
    Require all denied
</Directory>

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css   "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
